# Copy to .env (gitignored). Never commit real credentials.

# ── Core ────────────────────────────────────────────────────────────────────
# With `just stack-up` the DB is on :5434 and the role is created by V1 migration.
QORTIA_DATABASE_URL=postgresql://qortia_platform:qortia_platform@127.0.0.1:5434/qortia
# Point at the LiteLLM *gateway* (not Ollama) for virtual keys + multi-tenant OTel.
QORTIA_LITELLM_URL=http://127.0.0.1:4000
# Shared/master key (must match LITELLM_MASTER_KEY in docker-compose for local).
QORTIA_LITELLM_API_KEY=sk-qortia-local
LITELLM_MASTER_KEY=sk-qortia-local
# Optional: JSON map of tenant_id → LiteLLM virtual key (ADR-003).
# QORTIA_LITELLM_TENANT_KEYS={"11111111-1111-1111-1111-111111111111":"sk-tenant-a"}
# Optional: mount a host Ollama model cache into compose (skip re-pull):
# OLLAMA_MODELS_DIR=/home/you/.ollama

# ── Embeddings (defaults match migrations/V1 vector(1024) + BGE-M3) ─────────
# Register the model alias on your LiteLLM/Ollama gateway.
QORTIA_EMBEDDING_MODEL=bge-m3
QORTIA_EMBEDDING_DIMENSION=1024
QORTIA_EMBEDDING_CACHE_MAX_SIZE=10000
QORTIA_EMBEDDING_CACHE_TTL_SECONDS=3600
# Calibrated for BGE-M3 — re-tune if you change models.
QORTIA_DEDUP_SIMILARITY_THRESHOLD=0.95

# ── Optional ────────────────────────────────────────────────────────────────
QORTIA_EVAL_MODE=false
QORTIA_RERANK_MODEL=anthropic/claude-3-haiku-20240307
QORTIA_REFLECTION_THRESHOLD=10
QORTIA_IDLE_REFLECTION_INTERVAL_S=300
QORTIA_IDLE_REFLECTION_WINDOW_H=1

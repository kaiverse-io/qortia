# Copy to .env (gitignored). Never commit real credentials.

# ── Core ────────────────────────────────────────────────────────────────────
# With `just stack-up` the DB is on :5434 and the role is created by V1 migration.
QORTIA_DATABASE_URL=postgresql://qortia_platform:qortia_platform@127.0.0.1:5434/qortia
# Point at the LiteLLM *gateway* (not Ollama) for virtual keys + multi-tenant OTel.
QORTIA_LITELLM_URL=http://127.0.0.1:4000
# Shared/master key (must match LITELLM_MASTER_KEY in docker-compose for local).
QORTIA_LITELLM_API_KEY=sk-qortia-local
LITELLM_MASTER_KEY=sk-qortia-local
# Optional: JSON map of tenant_id → LiteLLM virtual key (ADR-003).
# QORTIA_LITELLM_TENANT_KEYS={"11111111-1111-1111-1111-111111111111":"sk-tenant-a"}
# Optional: mount a host Ollama model cache into compose (skip re-pull):
# OLLAMA_MODELS_DIR=/home/you/.ollama

# ── Embeddings (defaults match migrations/V1 vector(1024) + BGE-M3) ─────────
# Register the model alias on your LiteLLM/Ollama gateway.
QORTIA_EMBEDDING_MODEL=bge-m3
QORTIA_EMBEDDING_DIMENSION=1024
QORTIA_EMBEDDING_CACHE_MAX_SIZE=10000
QORTIA_EMBEDDING_CACHE_TTL_SECONDS=3600
# Calibrated for BGE-M3 — re-tune if you change models.
QORTIA_DEDUP_SIMILARITY_THRESHOLD=0.95

# ── Optional ────────────────────────────────────────────────────────────────
QORTIA_EVAL_MODE=false
# Unset (default) = /v1/admin/* (qortia.admin_router, ADR-004) is not mounted
# at all. Set to a long random value to enable HTTP tenant/agent/key
# provisioning for callers with no shell into this container; keep it as
# secret as a DB credential. Generate one with: openssl rand -hex 32
# QORTIA_ADMIN_TOKEN=
# Unset (default) = LLM reranking AND reflection are both skipped (they
# share this one setting — recall_rerank._llm_rerank, entity_graph.
# _update_entity_summary, reflect.py's two callers all read it), not
# attempted against an unconfigured model. No vendor default is shipped
# here — unlike QORTIA_EMBEDDING_MODEL (structurally pinned to
# migrations/V1's vector(1024)), nothing about this is load-bearing.
# For a local Ollama-only stack (no LiteLLM gateway — see QORTIA_LITELLM_URL
# above), pull a real chat model directly: `docker exec qortia-ollama-1
# ollama pull qwen2.5:3b`. Verified live against real /v1/reflect data:
# qwen2.5:0.5b and :1.5b both fail to reliably follow reflection's
# structured JSON contract (invalid action / non-numeric importance); 3b
# is the smallest size found that reflects correctly end-to-end.
# Also remember to add QORTIA_RERANK_MODEL to *both* app's and worker's
# `environment:` blocks in docker-compose.yml if you add a new setting here
# — compose does not pass arbitrary .env vars into a container, only ones
# explicitly listed per-service (found live: worker runs the background
# reflection trigger and was missing this entirely).
# QORTIA_RERANK_MODEL=qwen2.5:3b
QORTIA_REFLECTION_THRESHOLD=10
QORTIA_IDLE_REFLECTION_INTERVAL_S=300
QORTIA_IDLE_REFLECTION_WINDOW_H=1

# ── Recall tuning ─────────────────────────────────────────────────────────
# Result-count limits, RRF k, and the response char budget were hardcoded in
# recall_helpers.py; now file-configurable too — see qortia.example.toml
# (copy to qortia.toml, or point QORTIA_CONFIG_FILE at another path). Env
# vars here still win over the file if both are set.
# QORTIA_CONFIG_FILE=qortia.toml
# QORTIA_RECALL_RRF_K=60
# QORTIA_RECALL_SEARCH_FETCH_MULTIPLIER=2
# QORTIA_RECALL_PRIVATE_RESULT_LIMIT=20
# QORTIA_RECALL_ORG_RESULT_LIMIT=10
# QORTIA_RECALL_KNOWLEDGE_RESULT_LIMIT=16
# Applied when a /v1/recall caller doesn't pass max_chars explicitly (0 or
# negative = no default cap, the original unbounded behaviour). Measured
# unbounded: 38,961 chars/call average against a real 276-doc corpus for
# 5.5% precision (agnova's evals/run_scale_eval_qortia.py).
# QORTIA_RECALL_DEFAULT_MAX_CHARS=8000
